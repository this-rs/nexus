flowchart TD
    subgraph legend["Légende"]
        direction LR
        L1["✅ écrit et vérifié par un test"]
        L2["🟠 décidé, non écrit"]
        L3["🔴 bug confirmé / code non branché"]
        L4["⚪ hors de ce dépôt"]
    end

    HARNESS["⚪ harnais natif (nexus-claude)<br/>McpClient : stdio ou HTTP"]

    subgraph serveur["Serveur MCP — server.rs, http.rs, protocol.rs"]
        direction TB
        RPC["✅ JSON-RPC : initialize, ping, tools/list, tools/call<br/><i>vérifié : tests/protocol.rs, sur flux de lignes</i>"]
        STDIO["✅ stdio : appels concurrents, notifications/cancelled avorte l'outil,<br/>fin d'entrée avorte les appels en cours<br/><i>vérifié : un outil lent est abandonné (AbortOnDrop)</i>"]
        HTTP["✅ HTTP : jeton Bearer, Host loopback, Origin refusé sauf liste,<br/>corps ≤ 1 MiB, état de session par mcp-session-id, DELETE l'oublie<br/><i>vérifié : le vrai McpClient du harnais pilote le serveur</i>"]
        CAP["✅ plafond de sortie avec marqueur de troncature explicite ;<br/>panique d'un outil = un appel en échec ; journal sans arguments<br/><i>vérifié : sentinelle absente du journal et de stderr</i>"]
    end

    subgraph acces["Accès — profile.rs, token.rs, registry.rs"]
        direction TB
        TOKEN["✅ jeton v1 signé HMAC-SHA256, clé ≥ 32 octets, expiration,<br/>un seul message d'échec<br/><i>vérifié : tests unitaires et refus HTTP 401</i>"]
        PROFILE["✅ profil par session : un outil hors profil n'est ni listé ni exécuté,<br/>et « interdit » a la même réponse que « inexistant »<br/><i>vérifié : compteur d'exécution à 0 ; mutation jouée</i>"]
        BOUND["✅ un processus par session, borné au lancement (N27) : --tools (noms canoniques) = seuls outils listés ET exécutés, refus MCP -32602 même sur appel direct ; nom inconnu = sortie code 2 avec les noms valides ; intersection avec un profil signé ou --unrestricted, jamais plus large ; --trust-harness refusé avec --listen (code 2) : jetons signés pour HTTP<br/><i>vérifié : tests/session_bound.rs (13 tests, vrai binaire ; 10 rouges avant le changement) ; mutations : refus --listen retiré, filtre retiré, --tools qui remplace le profil, union au lieu d'intersection : chacune rougit au moins un test</i>"]
    end

    subgraph fichiers["Outils fichiers — files/*.rs (N19)"]
        direction TB
        SCOPE["✅ périmètre : résolution composant par composant,<br/>liens symboliques et .. suivis là où ils mènent<br/><i>vérifié : tests/files.rs, un test par évasion</i>"]
        STATE["✅ état « lu » par session : Edit/Write/NotebookEdit refusent un fichier<br/>non lu ou modifié depuis la lecture<br/><i>vérifié : mutation jouée (garde ignorée → test rouge)</i>"]
        READ["✅ Read : texte numéroté comme cat -n, notebooks en cellules,<br/>plafond en caractères avec coupe annoncée (écart volontaire) ;<br/>Read et Edit refusent un fichier texte de plus de 64 Mio (FileConfig::with_max_text_bytes) en disant la taille, la limite et comment continuer<br/><i>vérifié : longueurs du relevé de Claude Code 2.1.287 ; tests/files.rs, un fichier à la limite exacte se lit encore</i>"]
        WRITE["✅ Write, Edit : messages du relevé, jamais de fichier tronqué<br/>(temporaire voisin, fsync, rename), sauvegarde optionnelle<br/><i>vérifié : lecteur concurrent ne voit jamais un fichier à moitié écrit</i>"]
        NB["✅ NotebookEdit : replace, insert, delete par id de cellule ;<br/>JSON indenté d'un espace, ordre des clés conservé (type local)<br/><i>vérifié : fichier final comparé octet pour octet</i>"]
        SEARCH["✅ Glob (mtime décroissant, 100 chemins, gitignore) et Grep<br/>(content, files_with_matches, count, -i -n -A -B -C, glob, type, multiline,<br/>head_limit, offset) sur ignore + globset + regex, sans binaire rg<br/><i>vérifié : sortie identique à un vrai rg (ou à ses goldens) ; liens non suivis</i>"]
        IMGPDF["✅ Read d'une image : bloc image MCP + ligne de texte de repli ; Read d'un PDF (lopdf, Rust pur) : texte par pages, 20 pages max par appel, plus de 10 pages exigent `pages`<br/><i>vérifié : tests/files.rs (PDF construit à la main, mutation rouge)</i>"]
    end

    subgraph shell["Outils shell — shell/*.rs (N20)"]
        direction TB
        BASH["✅ Bash : sortie des deux flux fusionnée, codes de sortie, délai 120 s (max 600 s),<br/>au-delà de 30 000 octets sortie sur disque + aperçu de 2 Ko (formats du relevé 2.1.287),<br/>répertoire de travail persistant, un cd hors périmètre est annulé ;<br/>sortie plafonnée à 64 Mio sur disque (ShellConfig::with_max_output_bytes) : au-delà le groupe de processus est tué, le fichier recoupé et terminé par une ligne qui le dit, la tête seule est lue ; tâches de fond et Monitor identiques<br/><i>vérifié : tests/shell.rs, messages du relevé ; un « yes » en avant-plan et en arrière-plan est arrêté au plafond, test rouge quand la surveillance est neutralisée (mutation jouée sous ulimit)</i>"]
        GROUP["✅ groupe de processus : timeout, appel abandonné, TaskStop et fin de session<br/>tuent la commande ET ses descendants (SIGTERM puis SIGKILL du groupe)<br/><i>vérifié : un petit-enfant sleep disparaît ; 3 mutations rouges</i>"]
        BG["✅ arrière-plan : identifiant, sortie lisible pendant et après avec Read,<br/>TaskStop idempotent, tâches isolées par session ;<br/>pour le harnais (additif, le texte du modèle ne bouge pas) : structuredContent.background_task {id, kind shell|monitor, command, output_file, pid = groupe, status running|completed|failed|killed} sur Bash run_in_background, Monitor et TaskStop, et une notification notifications/message logger nexus-tools/tasks {task_id, event ended, status, exit_code} à la fin de chaque tâche<br/><i>vérifié : tests/shell.rs (a_background_task_is_described_in_structured_content_and_its_end_is_notified) ; suivi natif de bout en bout : tests/native_e2e.rs</i>"]
        MON["✅ Monitor : une notification notifications/message par ligne, dans l'ordre,<br/>fin signalée avec le processus ; fin d'entrée stdio ne reste jamais suspendue<br/><i>vérifié : tests/monitor.rs (régression d'une suspension réelle)</i>"]
        ENV["✅ environnement vierge : PATH LANG LC_* TZ seulement + ajouts explicites,<br/>HOME propre au serveur, texte de la commande hors argv<br/><i>vérifié : aucune variable CARGO_* ne passe</i>"]
        NOSANDBOX["🟠 Bash n'est PAS un bac à sable : il lit tout ce que l'utilisateur système peut lire ;<br/>la protection est la politique du harnais et l'environnement vierge"]
    end

    subgraph web["WebFetch — web/*.rs (N21)"]
        direction TB
        SSRF["✅ garde SSRF : privé, loopback, link-local (métadonnées cloud), CGNAT, multicast, réservé ;<br/>IPv6 : mappé, compatible, NAT64 (dont 64:ff9b:1::/48 à usage local), SIIT (::ffff:0:0/96), 6to4 et son relais anycast 192.88.99.0/24, Teredo, ORCHID et ORCHIDv2, ULA ; toutes les écritures numériques d'IPv4<br/><i>vérifié : un test rouge par vecteur, zéro connexion tentée ; 5 mutations rouges, plus une mutation jouée sur les plages SIIT, NAT64 local et relais 6to4</i>"]
        PIN["✅ résolution : TOUTES les adresses d'un nom sont contrôlées, la connexion va à l'adresse contrôlée<br/>(épinglée), chaque redirection est résolue et contrôlée de nouveau<br/><i>vérifié : rebinding DNS refusé au second saut</i>"]
        REDIR["✅ redirections : même hôte suivi (www. ignoré, http vers https accepté), autre hôte ou retour à http<br/>signalé avec l'URL cible, boucle bornée<br/><i>vérifié : tests/web.rs</i>"]
        CONV["✅ HTML vers Markdown (htmd, mesuré sur un corpus de 5 pages contre 4 autres crates) :<br/>titres, listes, tableaux, code avec langage, liens et images rendus absolus ;<br/>scripts, styles, svg, iframe jamais dans le texte ; décodage du charset<br/><i>vérifié : tests/web_convert.rs</i>"]
        CAPS["✅ plafonds : 5 Mio téléchargés, 100 000 caractères rendus, coupe annoncée ;<br/>binaire refusé (erreur typée) ; cache 15 min à horloge injectée ; aucun appel de modèle caché"]
        TLS["✅ https : rustls + ring + racines Mozilla derrière la feature `tls` (désactivée par défaut) ; nom vérifié contre l'URL ; exception à la règle « Rust seul » limitée à ring et cc, vérifiée par le test de politique ;<br/>Fetcher::new choisit TlsConnector sous la feature (il gardait PlainConnector : un binaire construit avec tls répondait « no TLS support »), supports_tls() le fige sans réseau<br/><i>vérifié : tests/tls.rs (de confiance, non fiable, autre nom, upgrade http) ; tests/web.rs, les deux configurations ; une vraie page https récupérée par un test ignoré par défaut</i>"]
    end

    subgraph search["WebSearch — search/*.rs (N22)"]
        direction TB
        TRAIT["✅ trait SearchBackend + moteurs essayés dans l'ordre : repli sur panne,<br/>disjoncteur (N échecs consécutifs, demi-ouvert, une sonde), limitation de débit,<br/>quota et clé refusée ne comptent pas comme panne<br/><i>vérifié : tests/search_core.rs, horloge injectée ; 4 mutations rouges</i>"]
        FILTER["✅ domaines autorisés/bloqués appliqués APRÈS le moteur (un moteur qui renvoie un domaine bloqué<br/>est démenti) ; URL canoniques fusionnées (schéma, www, fragment, paramètres de suivi) ;<br/>mode étendu : plusieurs requêtes fusionnées par rang réciproque, standard : une seule"]
        UNTRUSTED["✅ résultats = données non fiables : étiquetés, une ligne par champ, longueurs bornées,<br/>jamais d'instruction ; aucun appel de modèle caché"]
        ENGINES["✅ trois moteurs, une même suite contre fake_search : API à clé (forme Brave),<br/>SearXNG auto-hébergé, HTML sans clé (fragile, désactivé par défaut, nommé explicitement)<br/><i>vérifié : tests/search_conformance.rs</i>"]
        KEYS["✅ clé par RÉFÉRENCE (variable d'environnement ou fichier), jamais en clair : en-tête seulement,<br/>absente de l'URL, du Debug, des erreurs, de la sortie et de stderr ; une clé collée à la place<br/>d'un nom est refusée sans être répétée<br/><i>vérifié : mutations « clé dans l'URL » et « Debug affiche la clé » rouges</i>"]
        STLS["✅ les moteurs en https passent par le même connecteur"]
    end

    subgraph bench["Banc de parité — tests/parity_replay.rs (N25)"]
        REPLAY["✅ les 52 appels enregistrés sur le vrai Claude Code 2.1.287 sont rejoués hors ligne sur nexus-tools :<br/>48 identiques au caractère près, 3 écarts volontaires listés avec leur raison, 1 dépendant de la machine ;<br/>une excuse devenue fausse fait aussi échouer le banc<br/><i>vérifié : 3 divergences introduites dans Edit et Bash, 1 excuse périmée — toutes rouges</i>"]
    end

    subgraph harness["Branchement au harnais natif — N24 (voir nexus-agent-providers, noeud NATTOOLS)"]
        WIRED["✅ chaque outil traverse le vrai NativeProvider : Write, Read, Edit, Glob, Grep, NotebookEdit, Bash, WebFetch (SSRF refusée de bout en bout), WebSearch ;<br/>événements au nom canonique ; politique par motifs à la Claude Code ; outil hors profil jamais exécuté ; aucune variable de l'hôte dans une commande ; fin de session = commandes arrêtées ; tâche de fond suivie (snapshot background_tasks, fin notifiée → completed), cancel_tools(task) tue le groupe, scénario de conformité annulation_tache JOUÉ<br/><i>vérifié : tests/native_e2e.rs (15 tests ; les 3 du suivi rouges sans le changement)</i>"]
    end

    subgraph browser["Navigateur optionnel — N23 (attaché, jamais compilé)"]
        OBSCURA["✅ Obscura = serveur MCP externe `obscura mcp` (V8/C++ hors de notre build et de notre processus) : absent → aucun outil browser_*, notice, appel refusé ;<br/>jamais --stealth ni --allow-private-network, OBSCURA_ALLOW_PRIVATE_NETWORK=0 ; lectures sans approbation, navigation et interactions demandent ; destination privée refusée avant toute demande<br/><i>vérifié : tests/native_browser.rs contre fake_obscura (liste d'outils de la documentation) ; 3 mutations rouges</i><br/>🟠 jamais joué contre un vrai Obscura (test #[ignore] écrit, binaire absent)"]
    end

