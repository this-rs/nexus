    subgraph authz["Authentification — core::auth, branchée par build_router"]
        direction TB
        mauth{"auth_enabled"}
        mauth -->|"false, défaut livré"| anon["✅ aucune couche posée, tout est servi en anonyme<br/><i>vérifié : credential absurde ignoré, 200 quand même</i>"]
        mauth -->|"true"| authmw
        authmw["✅ core::auth::auth_middleware monté par from_fn_with_state<br/>avec un Arc de AuthManager, à l'intérieur de request_id et de CORS<br/>la couche englobe aussi le fallback : un chemin inconnu rend 401 avant 404,<br/>donc la table de routes n'est pas énumérable en anonyme<br/><i>vérifié : 401 anonyme sur v1/models, stats, v1/conversations,<br/>v1/chat/completions, v1/models/refresh, healthz et no-such-route</i>"]
        authmw -->|"aucun en-tête Authorization — refusé"| a401["✅ 401 UNAUTHORIZED<br/>la réponse porte quand même son x-request-id"]
        authmw -->|"schéma Basic, bearer minuscule ou Token — refusé"| a401
        authmw -->|"chemin dans UNAUTHENTICATED_PATHS"| ahealth
        authmw -->|"préfixe Bearer, jeton vérifié par verify_token"| apass
        authmw -->|"jeton non signé, autre secret, expiré ou altéré — refusé"| a401
        apass["✅ next.run APRÈS vérification de la signature et de exp<br/>les Claims vérifiées sont insérées en extension de requête,<br/>donc un handler lit Extension de Claims et obtient le sub signé<br/><i>vérifié : Bearer x rend 401 (rendait 200) ; jeton d'un autre<br/>secret, expiré ou altéré rendent 401 ; sub lu en aval</i>"]
        amgr["✅ AuthManager::verify_token appelé par le middleware<br/>auth.secret_key est enfin consulté<br/>🟠 auth.token_expiry_hours reste inerte : aucune route ne frappe<br/>de jeton, generate_token n'a pas d'appelant de production<br/><i>vérifié : le secret porté par la passerelle valide un jeton frappé<br/>avec la même chaîne</i>"]
        apass -.->|"appelle"| amgr
        ahealth["✅ /health reste anonyme<br/>exemption décidée DANS le middleware, pas en sortant la route<br/>de la couche — sortir la route aurait rendu le fallback anonyme<br/><i>vérifié : health rend OK sans jeton ; healthz, no-such-route<br/>et health/../stats rendent 401</i>"]
        aboot["✅ refus de démarrer si auth.enabled vaut true<br/>avec le secret de notoriété publique ou un secret vide<br/>AuthConfig::validate appelée depuis build_components<br/><i>vérifié : build_components rend Err(PlaceholderSecretKey)</i>"]
    end

