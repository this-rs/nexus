        buildcomp --> cm["✅ ClaudeManager::new, avec claude.command,<br/>file_access et mcp<br/><i>vérifié : FakeClaudeCli passé par la chaîne claude.command</i>"]
        buildcomp --> pool["✅ ProcessPool::new, PoolConfig issu de process_pool<br/>idle_timeout_secs 300 et default_model claude-sonnet-5 codés en dur<br/><i>vérifié : min_idle 0 en test, sinon deux processus seraient lancés</i>"]
        buildcomp --> ism["✅ InteractiveSessionManager::new"]
        buildcomp --> store["✅ InMemoryConversationStore, ConversationManager::new,<br/>ResponseCache::new avec les configs par défaut<br/><i>vérifié : POST puis GET sur /v1/conversations</i>"]
