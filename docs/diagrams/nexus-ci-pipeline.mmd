%% name: nexus-ci-pipeline
%% covers: .github/workflows/ci.yml, .github/workflows/release.yml
%% verified: 2026-10-18
flowchart TD
    subgraph PR["Pull Request"]
        direction TB
        push[Push / PR] --> fmt

        fmt["fmt\n✅ rustfmt --check (cargo fmt-nexus : les crates nexus, pas le fork obscura/)\n✅ diagram index derived & current (cargo xtask)"]
        push --> drift["diagram-drift (PR only)\n✅ covered file changed ⇒ .mmd touched\nor Diagram-Unchanged trailer with a reason\n(cargo xtask diagrams drift · xtask/tests/commands.rs)"]
        drift --> ok
        push --> clippy["clippy\n✅ -D warnings\n(features : scripts/nexus-features.sh = toutes sauf nexus-tools/obscura, partout)"]
        push --> test["test matrix\nmacOS stable · Windows stable\nLinux beta + nightly (advisory)\ncargo test (build + doc tests)"]
        push --> conf["conformance (one job per provider)\nclaude-code · native · codex · acp · scripted\ncargo test -p nexus-claude, that provider's features only\nagainst its fake executable (fake_claude, fake_openai + fake_mcp, fake_codex, fake_acp)\nreal-CLI tests stay ignored (docs/CI_CD.md)"]
        push --> cov["ubuntu stable: test + coverage\ncargo llvm-cov (the one run of the suite)\n+ doc tests + logic-only report"]
        push --> docs["docs\ncargo doc"]
        push --> obscura["obscura (Linux)\nV8 épinglé, SHA-256 vérifié (scripts/rusty-v8-cache.sh)\nclippy + test nexus-tools --features obscura\n+ cargo nextest des crates obscura/ (un processus par test, --target explicite)"]
        push --> msrv["MSRV 1.88\ncargo check"]

        fmt --> ok{CI Success}
        clippy --> ok
        test --> ok
        conf --> ok
        cov --> ok
        docs --> ok
        msrv --> ok
        obscura --> ok

        cov --> cc["Codecov\n🟠 project: informational\n✅ patch: blocking ≥80 %\n✅ patch agent/ + providers/*/map_events.rs: blocking ≥90 %"]
    end

    subgraph REL["Release (tag v*)"]
        direction TB
        tag[Tag push v*] --> changelog[Generate changelog]
        changelog --> ghrel[Create GitHub Release]
        ghrel --> build[Build artifacts]

        build --> lic["Third-party licences\ncargo about --fail (pinned 0.9.2) + our LICENSE\ngenerated next to the binary before packaging"]
        lic --> linux["Linux\nx64 / ARM64\ntar.gz\n+ LICENSE, THIRD-PARTY-LICENSES.txt"]
        lic --> macos["macOS\nx64 / ARM64\ntar.gz\n+ LICENSE, THIRD-PARTY-LICENSES.txt"]
        lic --> win["Windows\nx64\nzip\n+ LICENSE, THIRD-PARTY-LICENSES.txt"]

        linux & macos & win --> upload[Upload to Release]

        ghrel --> pub[Publish to crates.io]
        pub --> sdk[nexus-claude]
        pub --> api[claude-code-api]
        sdk & api --> vbranch[Update version branch]
    end

    subgraph ADV["Advisory (non-blocking)"]
        security["security\ncargo-deny audit"]
    end
