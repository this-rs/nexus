%% name: nexus-ci-pipeline
%% covers: .github/workflows/ci.yml, .github/workflows/release.yml
%% verified: 2026-10-09
flowchart TD
    subgraph PR["Pull Request"]
        direction TB
        push[Push / PR] --> fmt

        fmt["fmt\n✅ rustfmt --check\n✅ diagram index derived & current (cargo xtask)"]
        push --> drift["diagram-drift (PR only)\n✅ covered file changed ⇒ .mmd touched\nor Diagram-Unchanged trailer with a reason\n(cargo xtask diagrams drift · xtask/tests/commands.rs)"]
        drift --> ok
        push --> clippy["clippy\n✅ -D warnings"]
        push --> test["test matrix\nmacOS stable · Windows stable\nLinux beta + nightly (advisory)\ncargo test (build + doc tests)"]
        push --> cov["ubuntu stable: test + coverage\ncargo llvm-cov (the one run of the suite)\n+ doc tests + logic-only report"]
        push --> docs["docs\ncargo doc"]
        push --> msrv["MSRV 1.88\ncargo check"]

        fmt --> ok{CI Success}
        clippy --> ok
        test --> ok
        cov --> ok
        docs --> ok
        msrv --> ok

        cov --> cc["Codecov\n🟠 project: informational\n✅ patch: blocking ≥80 %"]
    end

    subgraph REL["Release (tag v*)"]
        direction TB
        tag[Tag push v*] --> changelog[Generate changelog]
        changelog --> ghrel[Create GitHub Release]
        ghrel --> build[Build artifacts]

        build --> linux["Linux\nx64 / ARM64\ntar.gz"]
        build --> macos["macOS\nx64 / ARM64\ntar.gz"]
        build --> win["Windows\nx64\nzip"]

        linux & macos & win --> upload[Upload to Release]

        ghrel --> pub[Publish to crates.io]
        pub --> sdk[nexus-claude]
        pub --> api[claude-code-api]
        sdk & api --> vbranch[Update version branch]
    end

    subgraph ADV["Advisory (non-blocking)"]
        security["security\ncargo-deny audit"]
    end
