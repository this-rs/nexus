flowchart TB
    subgraph runtime["Resolution a l'execution"]
        KEY["✅ ANTHROPIC_API_KEY present — ModelRegistry::new journalise l'absence de cle et sert le repli"]
        FETCH["✅ ModelRegistry::fetch_remote — GET api.anthropic.com/v1/models, en-tetes x-api-key + anthropic-version"]
        FALLBACK["✅ ClaudeModel::all — catalogue statique de repli, 12 entrees au sha verifie"]
        CACHE["✅ ModelRegistry::get_models — sert le cache, ModelRegistry::needs_refresh decide du rafraichissement"]
        IS_DYN["✅ ModelRegistry::is_dynamic — dit laquelle des deux sources a repondu"]
    end

    subgraph served["Ce que le serveur expose"]
        LIST["✅ list_models sur GET /v1/models — la seule liste qui fasse foi"]
        REFRESH["✅ refresh_models sur POST /v1/models/refresh — force un re-fetch"]
        ALIAS["🟠 Aliases opus / sonnet / haiku — documentes et utilises partout dans la doc, resolution non relue a ce sha"]
    end

    subgraph docs["Documentation"]
        PROSE["✅ README.md section Supported Models — renvoie a GET /v1/models, n'enumere plus"]
        VALID["✅ docs/valid-models.md — table des deux sources, plus de liste d'identifiants"]
        GUIDES["✅ 16 fichiers corriges — identifiants remplaces par des aliases"]
        STALE["🔴 README_CN / README_JA / SDK README_CN / README_JA — perimes, bandeau date du 01/10/2026 au lieu d'une traduction"]
        CHANGELOG["⚪ CHANGELOG.md — garde ses identifiants retires : il raconte l'histoire, pas l'etat actuel, et reste hors du balayage"]
    end

    subgraph gate["Portillon hors reseau"]
        SWEEP["✅ checked_documents — balaye les .md, exclut CHANGELOG, RELEASE_* et les traductions"]
        DETECT["✅ model_ids_in plus looks_like_a_model_id — distingue un identifiant de claude-code-api ou claude-agent-sdk"]
        PARSE["✅ catalogue_ids — lit les champs id du texte source, faute de cible [lib] a importer"]
        COMPARE["✅ documentation_names_no_model_the_code_does_not_know — echoue si un identifiant cite est absent du catalogue"]
        BANNER["✅ every_translation_carries_a_dated_staleness_notice — exige bandeau, date, renvoi a README.md et mention du registre"]
        AUTHORITY["✅ the_english_readme_carries_no_staleness_notice — l'autorite ne peut pas se declarer elle-meme perimee"]
        ESCAPE["🟠 DOCUMENTED_COUNTER_EXAMPLES — un seul identifiant tolere, montre comme refuse dans la prose ; la liste n'est pas censee croitre"]
    end

    KEY -->|cle presente| FETCH
    KEY -->|pas de cle ou echec| FALLBACK
    FETCH --> CACHE
    FALLBACK --> CACHE
    CACHE --> LIST
    CACHE --> IS_DYN
    REFRESH --> FETCH
    LIST --> ALIAS

    LIST -.->|source de verite citee par| PROSE
    LIST -.->|source de verite citee par| VALID
    PROSE --> GUIDES
    VALID --> GUIDES

    SWEEP --> DETECT
    DETECT --> COMPARE
    PARSE --> COMPARE
    FALLBACK -.->|lu comme texte par| PARSE
    GUIDES -.->|verifie par| COMPARE
    PROSE -.->|verifie par| COMPARE
    VALID -.->|verifie par| COMPARE
    STALE -.->|verifie par| BANNER
    PROSE -.->|verifie par| AUTHORITY
    COMPARE --> ESCAPE
    CHANGELOG -.->|hors balayage, volontairement| SWEEP
