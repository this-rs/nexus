    %% =================================================================
    %% 1. Trouver ou installer le CLI — cli_download.rs
    %% =================================================================
    subgraph acq["Acquisition du CLI — cli_download.rs"]
        direction TB
        ENSURE["✅ ensure_cli(auto_download)<br/>seul point d’entrée public<br/><i>vérifié : HOME et PATH neutralisés, serveur wiremock</i>"]
        FIND["⚪ find_claude_cli()<br/>transport::subprocess : PATH, cache SDK, emplacements connus"]
        CACHED["🔴 ensure_cli — branche cache<br/>exige maintenant exists() ET is_file()<br/>branche morte : find_claude_cli teste déjà la même chose<br/><i>vérifié : test rejoué sans le correctif</i>"]
        NOAUTO["✅ Err CliNotFound<br/>le message explique auto_download_cli(true) et npm install -g<br/><i>vérifié : assertion sur le texte</i>"]
        DL["✅ download_cli(version, on_progress)<br/>crée le répertoire de cache puis délègue<br/><i>vérifié : cache dans un tempdir</i>"]
        DLSTUB["🟠 download_cli — stub sans la feature auto-download<br/>renvoie ConfigError : installez manuellement<br/>compilé mais jamais exécuté par un test : aucune cible de test ne tourne sans la feature"]
        NOCACHE["🟠 ConfigError : cache introuvable<br/>get_cache_dir() ne renvoie None que si dirs::home_dir() échoue — inatteignable depuis un test"]
        MKDIRKO["✅ ConfigError : Failed to create cache directory<br/><i>vérifié : chemin de cache placé dans un fichier régulier</i>"]
        PLAT["✅ install_cli_for_platform()<br/>aiguillage cfg(unix) / cfg(windows)"]
        WIN["🟠 install_cli_windows()<br/>npm puis script PowerShell install.ps1<br/>écrit mais jamais exécuté : cfg(windows), non compilé sur l’hôte de mesure"]

        ENSURE --> FIND
        FIND -->|"Ok — un CLI existe déjà"| RET["✅ Ok(chemin)"]
        FIND -->|"Err"| CACHED
        CACHED -->|"absent ou pas un fichier"| AUTO{"auto_download ?"}
        AUTO -->|"false — refus"| NOAUTO
        AUTO -->|"true"| DL
        DL -->|"cache indéterminable"| NOCACHE
        DL -->|"mkdir impossible"| MKDIRKO
        DL -->|"répertoire prêt"| PLAT
        PLAT --> WIN
        AUTO -->|"true, mais feature auto-download absente"| DLSTUB
    end

    subgraph unixinst["Installation Unix — install_cli_unix()"]
        direction TB
        UNIX["✅ install_cli_unix(version, target, on_progress)<br/>progress(0, None) puis progress(100, Some(100)) en cas de succès<br/><i>vérifié : rappels de progression collectés</i>"]
        GET["✅ GET claude.ai/install.sh<br/>URL injectée par test_override, compilé uniquement en build de test<br/><i>vérifié : wiremock ; un test d’intégration prouve que l’override est inerte hors cfg(test)</i>"]
        HTTPKO["✅ statut non 2xx → warn puis repli npm<br/><i>vérifié : réponses 404 et 503</i>"]
        NOPARENT["✅ target.parent() == None → abandon du script<br/><i>vérifié : cible = /</i>"]
        BASH["✅ bash -c script, CLAUDE_INSTALL_DIR = parent de la cible<br/><i>vérifié : script servi localement qui dépose un fichier</i>"]
        BASHKO["✅ sortie non nulle → warn(stderr), repli npm<br/>find_claude_cli n’est PAS consulté ici<br/><i>vérifié : script exit 3</i>"]
        OKTARGET["✅ la cible existe → Ok(cible)"]
        LOOKUP["✅ le script a menti : repli sur find_claude_cli() puis find_cli_in_known_locations()<br/>renvoie un CLI qu’il n’a pas installé<br/><i>vérifié : script exit 0 sans rien écrire</i>"]
        KNOWN["🔴 find_cli_in_known_locations()<br/>HOME/.local/bin/claude, HOME/.claude/local/claude, /usr/local/bin/claude — ignore les répertoires (is_file)<br/>repli INATTEIGNABLE : find_claude_cli teste déjà ces trois chemins avec le même exists() ET is_file()<br/><i>vérifié : la fonction elle-même testée avec un HOME temporaire</i>"]
        NPMGATE{"which(npm) ?"}
        NPMKO["✅ Err CliNotFound<br/>install script and npm both failed<br/><i>vérifié : chemin npm inexistant</i>"]
        NPMPKG["✅ spec npm : latest → paquet non épinglé, sinon @anthropic-ai/claude-code@version<br/><i>vérifié : argv enregistré par un faux npm</i>"]
        NPMTMP["🔴 répertoire de travail fixe : temp_dir()/cc-sdk-npm-install<br/>supprimé puis recréé à chaque appel — deux installations concurrentes s’écrasent<br/>un FICHIER résiduel à ce chemin bloque le repli npm pour toujours : remove_dir_all ne supprime que des répertoires<br/>to_str().unwrap() panique si le TMPDIR n’est pas de l’UTF-8<br/><i>vérifié : ConfigError Failed to create temp directory</i>"]
        NPMCOPY["✅ copie vers la cible puis chmod 0755<br/>répertoire de cache absent → ConfigError Failed to copy CLI to cache<br/>les deux erreurs de permissions qui suivent sont inatteignables : le fichier vient d’être créé par nous<br/><i>vérifié : mode du fichier relu, cible sans parent</i>"]
        NPMNOBIN["✅ npm a réussi sans node_modules/.bin/claude → Err CliNotFound<br/><i>vérifié : faux npm qui ne dépose rien</i>"]

        UNIX --> GET
        GET --> HTTPKO
        GET --> NOPARENT
        GET --> BASH
        BASH --> BASHKO
        BASH --> OKTARGET
        BASH --> LOOKUP
        LOOKUP -->|"jamais atteint"| KNOWN
        HTTPKO --> NPMGATE
        BASHKO --> NPMGATE
        LOOKUP -->|"rien trouvé"| NPMGATE
        NPMGATE -->|"absent — refus"| NPMKO
        NPMGATE -->|"présent"| NPMPKG
        NPMPKG --> NPMTMP
        NPMTMP --> NPMCOPY
        NPMTMP --> NPMNOBIN
    end

