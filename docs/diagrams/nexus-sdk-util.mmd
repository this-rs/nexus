    %% =================================================================
    %% 2. Budget de jetons — token_tracker.rs
    %% =================================================================
    subgraph budget["Budget — token_tracker.rs"]
        direction TB
        UPD["✅ BudgetManager::update_usage(in, out, cost)<br/>additionne puis évalue, jamais l’inverse<br/><i>vérifié : journal tracing capturé</i>"]
        NOLIMIT["✅ aucune limite posée → aucun rappel, aucun journal<br/>is_exceeded() reste false même à 2 M de jetons<br/><i>vérifié : rappel compté à zéro</i>"]
        CHECK["✅ BudgetLimit::check_limits(usage)<br/>coût d’abord, jetons ensuite"]
        COSTEX["✅ ratio coût ≥ 1.0 → Exceeded<br/>la borne exacte est Exceeded, pas Warning"]
        COSTWARN["✅ ratio coût ≥ seuil → Warning avec le message Cost usage at X%"]
        TOKEX["✅ ratio jetons ≥ 1.0 → Exceeded (écrase un Warning de coût)"]
        TOKWARN["✅ ratio jetons ≥ seuil → Warning<br/>le garde matches!(Exceeded) empêche la rétrogradation, mais le message jetons écrase celui du coût<br/><i>vérifié : les deux ordres testés</i>"]
        NANHOLE["🔴 cap à 0 ou négatif : 0/0 donne NaN, un cap négatif un ratio négatif<br/>toute comparaison est fausse → budget silencieusement illimité<br/>with_cost() et with_tokens() ne valident rien<br/><i>vérifié : tests qui épinglent le comportement actuel, non corrigé</i>"]
        CLAMP["🔴 with_warning_threshold() clampe au lieu de refuser<br/>seuil 0.0 → Warning dès 0 jeton consommé ; f64::NAN se propage et désarme l’alerte<br/><i>vérifié : seuils -1.0, 5.0 et NAN</i>"]
        WARNONCE["✅ Warning : rappel une seule fois (warning_fired)<br/>réarmé par set_limit(), clear_limit() et reset_usage()<br/><i>vérifié : compteur d’appels</i>"]
        EXEVERY["✅ Exceeded : rappel à CHAQUE mise à jour, sans dédoublonnage<br/>asymétrie assumée avec Warning<br/><i>vérifié : trois mises à jour, trois appels</i>"]
        OVERFLOW["🔴 total_tokens() additionne deux u64 sans saturation<br/>panique en build debug sur des compteurs absurdes — non testé, entrée irréaliste"]

        UPD --> NOLIMIT
        UPD --> CHECK
        CHECK --> COSTEX
        CHECK --> COSTWARN
        CHECK --> TOKEX
        CHECK --> TOKWARN
        CHECK --> NANHOLE
        CHECK --> CLAMP
        COSTWARN --> WARNONCE
        TOKWARN --> WARNONCE
        COSTEX --> EXEVERY
        TOKEX --> EXEVERY
        CHECK --> OVERFLOW
    end

    %% =================================================================
    %% 3. Utilitaires de performance — perf_utils.rs
    %% =================================================================
    subgraph perf["Performance — perf_utils.rs"]
        direction TB
        RETRY["✅ RetryConfig::retry(f)<br/>rejoue tant que retries reste inférieur à max_retries<br/><i>vérifié : horloge Tokio en pause</i>"]
        RETRYOK["✅ Ok au premier succès, même après des échecs"]
        RETRYJIT["✅ gigue = rand × delay × jitter_factor, puis abs()<br/>le délai ne peut donc que s’allonger, jamais se raccourcir<br/><i>vérifié : jitter_factor 1.0, durée écoulée minorée</i>"]
        RETRYBACK["✅ backoff : delay × multiplier, borné par max_delay<br/>la gigue n’est PAS bornée par max_delay"]
        RETRYERR["✅ retries épuisés → la DERNIÈRE erreur est renvoyée<br/><i>vérifié : messages numérotés</i>"]
        BATCH["✅ MessageBatcher::run()<br/>timeout(max_wait_time, recv())"]
        BFULL["✅ buffer ≥ max_batch_size → emit_batch()"]
        BCLOSE["✅ entrée fermée → vide le buffer puis sort de la boucle"]
        BTIME["✅ délai écoulé → émet un lot partiel<br/>délai écoulé à vide → ne publie rien et continue d’attendre<br/><i>vérifié : start_paused, aucun sleep réel</i>"]
        BEMPTY["✅ emit_batch() sur buffer vide → retour immédiat, aucun lot vide publié<br/>garde défensive : les trois appelants testent déjà is_empty()<br/><i>vérifié : appel direct de la méthode privée</i>"]
        BLOST["✅ récepteur disparu → warn et lot perdu<br/>le buffer est drainé AVANT l’envoi, donc les messages sont détruits<br/><i>vérifié : récepteur droppé</i>"]
        METRICS["🔴 PerformanceMetrics::record_success<br/>min_latency_ms traite 0 comme non initialisé : un échantillon réel à 0 ms est écrasé par le suivant<br/><i>vérifié : record_success(0) puis record_success(5) donne min = 5</i>"]

        RETRY --> RETRYOK
        RETRY --> RETRYJIT --> RETRYBACK
        RETRY --> RETRYERR
        BATCH --> BFULL
        BATCH --> BCLOSE
        BATCH --> BTIME
        BFULL --> BEMPTY
        BTIME --> BEMPTY
        BEMPTY --> BLOST
    end

