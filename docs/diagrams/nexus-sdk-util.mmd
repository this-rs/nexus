    subgraph mcp["MCP en processus — sdk_mcp.rs"]
        direction TB
        CALLER["⚪ internal_query : control_request subtype mcp_message<br/>downcast_ref vers SdkMcpServer puis send_sdk_control_response"]
        HM["✅ SdkMcpServer::handle_message(value)<br/>aiguillage sur method<br/><i>vérifié : un test par branche</i>"]
        NOMETHOD["✅ method absente ou non textuelle → Err InvalidState<br/>erreur HORS bande : c’est internal_query qui fabrique subtype error<br/><i>vérifié : method entière</i>"]
        INIT["✅ initialize → protocolVersion 2024-11-05, capabilities.tools vide, serverInfo"]
        LIST["✅ tools/list → tableau vide si aucun outil, jamais null<br/>republie inputSchema et required"]
        CALL["✅ tools/call"]
        CALLKO["✅ Err InvalidState si params absent, name absent, ou outil inconnu"]
        CALLARGS["✅ arguments absent → objet vide ; type non objet transmis tel quel<br/>le schéma annoncé n’est JAMAIS validé, required est ignoré<br/><i>vérifié : outil exigeant name appelé sans argument</i>"]
        DUP["✅ noms d’outils dupliqués acceptés par add_tool, le premier inscrit gagne<br/><i>vérifié : deux handlers distincts</i>"]
        CALLOK["✅ réponse : result.content sérialisé, isError repris du ToolResult<br/>isError null quand l outil ne le renseigne pas"]
        CALLERR["✅ handler Err → remonté à l’appelant, pas d erreur JSON-RPC en bande"]
        NOTIF["✅ notifications/initialized → répond quand même<br/>JSON-RPC interdit de répondre à une notification, mais la requête de contrôle qui l’enveloppe exige une réponse — sans id<br/><i>vérifié : forme exacte affirmée</i>"]
        UNKNOWN["✅ méthode inconnue → erreur EN bande, code -32601, id repris"]
        WIRE["✅ ToolResult sérialise is_error, le fil MCP attend isError<br/>la correspondance est faite à la main dans handle_message<br/><i>vérifié : les deux formes épinglées</i>"]

        CALLER --> HM
        HM --> NOMETHOD
        HM --> INIT
        HM --> LIST
        HM --> CALL
        CALL --> CALLKO
        CALL --> CALLARGS
        CALL --> DUP
        CALL --> CALLOK
        CALL --> CALLERR
        CALLOK --> WIRE
        HM --> NOTIF
        HM --> UNKNOWN
    end

