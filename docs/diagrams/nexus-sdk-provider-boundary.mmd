%% name: nexus-sdk-provider-boundary
%% covers: claude-code-sdk-rs/src/lib.rs, claude-code-sdk-rs/src/bin/fake_claude.rs
%% verified: 2026-10-05
%% ---
%% PROUVE : où passe la frontière entre « un agent quelconque » et « Claude Code »
%%   dans ce dépôt, au sha 443a2a0 (relu le 2026-10-02). Ce diagramme possède la
%%   surface publique (lib.rs) et le faux CLI (bin/fake_claude.rs) — c'est-à-dire
%%   ce qu'un appelant voit et ce qu'un provider doit reproduire. Le détail de chaque
%%   module reste dans nexus-sdk-transport, -interactive, -types, -client, -util.
%% ---
%% SOURCES LUES :
%%   claude-code-sdk-rs/src/lib.rs            — bloc `pub use` (clients, hooks, transport, types, memory)
%%   claude-code-sdk-rs/src/bin/fake_claude.rs — directives emit, emit_json, emit_partial, stderr, sleep,
%%                                               await_stdin, reply_control, wait_eof, exit, capture_hooks, emit_hook ; --version
%%   claude-code-sdk-rs/src/transport/mod.rs  — trait Transport (signatures), InputMessage
%%   claude-code-sdk-rs/src/transport/subprocess.rs — build_command, find_claude_cli, check_cli_version,
%%                                               spawn_process (routage stdout)
%%   claude-code-sdk-rs/src/types.rs          — Message, ContentBlock, StreamEventData, ClaudeCodeOptions,
%%                                               PermissionMode, SDKControlRequest, HookInput, McpServerConfig
%%   claude-code-sdk-rs/src/interactive.rs    — set_permission_mode, initialize_hooks, send_hook_response,
%%                                               build_interrupt_json (JSON de contrôle écrit à la main)
%%   claude-code-sdk-rs/src/query.rs          — query_print_mode (second constructeur de ligne de commande)
%%   claude-code-api/src/core/{claude_manager,interactive_session,process_pool}.rs — Command::new(claude)
%%   tests/support/mod.rs                     — fake_cli_path (CARGO_BIN_EXE_fake_claude)
%%   Commandes : grep -rn 'Command::new' claude-code-sdk-rs/src claude-code-api/src → 5 sites
%%               grep -rln fake_cli_path tests → 8 fichiers d'intégration
%%               grep -rn 'cancel_running_tools' . --include=*.rs → 0 (le backend PO le fait lui-même)
%% ---
%% NON ETABLI :
%%   aucune mesure de ce qu'un autre CLI d'agent (Codex, Gemini) émet réellement :
