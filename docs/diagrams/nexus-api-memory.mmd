%% name: nexus-api-memory
%% covers: claude-code-api/src/core/memory/*.rs
%% verified: 2026-10-01
flowchart TD
    subgraph legend["Légende"]
        direction LR
        L1["✅ écrit et vérifié par un test"]
        L2["🟠 décidé, non écrit"]
        L3["🔴 bug, ou code écrit non branché"]
        L4["⚪ hors dépôt"]
    end

    root["🔴 personne n'appelle cette mémoire<br/>un grep de UnifiedMemoryProvider, LongTermMemory,<br/>MediumTermMemory, ShortTermMemory et ContextualMemoryProvider<br/>dans claude-code-api/src ne sort que core/memory/ :<br/>ni build_router, ni build_components, ni un handler n'en construit un.<br/>Tout le sous-arbre est donc du code écrit non branché ;<br/>les ✅ ci-dessous sont vérifiés par des tests, les 🔴 par rien.<br/><i>vérifié : grep sur src, les tests sont les seuls appelants</i>"]
    caller["⚪ project-orchestrator REST et Meilisearch<br/>les deux services amont, jamais joints par un test"]

    subgraph traits_box["traits.rs — le contrat et le barème"]
        direction TB
        t_level["✅ MemorySource::level()<br/>Conversation 1, ProjectOrchestrator 2,<br/>CrossConversation et KnowledgeNote 3<br/><i>vérifié : traits::tests::test_memory_source_level</i>"]
        t_new["✅ RelevanceScore::new()<br/>combined = 0,5 semantic + 0,3 recency + 0,2 scope<br/><i>vérifié : traits::tests::test_relevance_score</i>"]
        t_weights["🔴 RelevanceScore::with_weights()<br/>poids explicites, aucun appelant dans le dépôt"]
        t_contract["✅ ContextualMemoryProvider<br/>query, search_context, get_relevant_decisions,<br/>current_scope, set_scope<br/>limit y est documenté comme un maximum<br/><i>vérifié : les trois implémentations sont exercées</i>"]
    end

    subgraph unified_box["unified.rs — UnifiedMemoryProvider"]
        direction TB
        u_query["✅ UnifiedMemoryProvider::query()<br/>per_level_limit = limit.max(5)<br/>interroge les trois étages en séquence, pas en parallèle,<br/>et propage la première erreur avec l'opérateur point d'interrogation<br/><i>vérifié : unified::tests::test_unified_memory_query, étages factices</i>"]
        u_weight["✅ apply_weight()<br/>multiplie combined selon source.level() :<br/>niveau 1 par 1,2, niveau 2 par 1,0, niveau 3 par 0,8<br/><i>vérifié : même test</i>"]
        u_thresh{"✅ retain : combined au moins min_score_threshold, défaut 0,1<br/><i>vérifié : les deux résultats du test passent le seuil</i>"}
        u_drop["🔴 résultat écarté, sans journal ni compteur<br/>aucun test n'amène un résultat sous le seuil"]
        u_dedup["✅ deduplicate()<br/>clé = 20 premiers mots alphanumériques en minuscules<br/>le premier arrivé gagne, donc le mieux noté<br/><i>vérifié : unified::tests::test_unified_memory_deduplication</i>"]
        u_take["🔴 take(limit) après tri décroissant<br/>exécuté par les tests, mais aucune troncature n'est affirmée"]
        u_ctx{"🔴 search_context() — match source_filter<br/>aucun test n'emprunte ce routage"}
        u_short["🔴 vers short_term.search_context"]
        u_medium["🔴 vers medium_term.search_context"]
        u_long["🔴 vers long_term.search_context"]
        u_dec["🔴 get_relevant_decisions()<br/>étage médian, plus une requête decision topic au long terme<br/>avec limit/2, sans seuil de score<br/>aucun test ne l'exécute"]
        u_scope["🔴 set_scope()<br/>mémorise la portée et ne la propage à aucun étage<br/>le commentaire du code assume le trou :<br/>impossible sans référence mutable sur les objets de trait"]

        u_query --> u_weight
        u_weight --> u_thresh
        u_thresh -->|"sous le seuil"| u_drop
        u_thresh -->|"au-dessus"| u_dedup
        u_dedup --> u_take
        u_ctx -->|"Some conversation"| u_short
        u_ctx -->|"Some plan, task, decision ou note"| u_medium
        u_ctx -->|"Some cross_conversation"| u_long
        u_ctx -->|"None ou filtre inconnu"| u_query
    end

    subgraph short_box["short_term.rs — ShortTermMemory, la conversation courante"]
        direction TB
        s_query["✅ ShortTermMemory::query()<br/><i>vérifié : short_term::tests, magasin en mémoire</i>"]
        s_noconv{"✅ conversation_id posé ?<br/><i>vérifié : les deux branches ont un test</i>"}
        s_empty["✅ Ok liste vide, sans erreur<br/><i>vérifié : test_short_term_no_conversation</i>"]
        s_get{"✅ store.get(conv_id) — la seule source d'erreur du fichier<br/>aucun test ne demande une conversation inconnue ni ne fait échouer le magasin"}
        s_content{"✅ msg.content"}
        s_text["✅ Text : repris tel quel<br/><i>vérifié : test_short_term_query</i>"]
        s_array["🔴 Array : concatène les ContentPart::Text avec un espace<br/>et ignore toute autre variante, image comprise<br/>aucun test ne passe un contenu en tableau"]
        s_none["🔴 message sans contenu : sauté par filter_map<br/>aucun test ne passe un message sans contenu"]
        s_rel{"✅ semantic sous 0,1 ?"}
        s_dropped["🔴 message écarté : l'étage court terme est le seul<br/>à filtrer sur la pertinence<br/>les deux messages du test passent le filtre : la branche reste nue"]
        s_score["✅ keyword_match_score() et recency_score()<br/>mots trouvés sur mots demandés, et rang du message<br/>sur le nombre de messages ; scope figé à 1,0<br/>recency_score renvoie 0,0 si le total est nul"]
        s_ctx["🔴 search_context()<br/>tout filtre autre que conversation renvoie une liste vide<br/>sans interroger le magasin ; aucun test ne l'appelle"]
        s_dec["🔴 get_relevant_decisions() renvoie une liste vide en dur<br/>le commentaire renvoie vers l'étage médian"]

        s_query --> s_noconv
        s_noconv -->|"non"| s_empty
        s_noconv -->|"oui"| s_get
        s_get -->|"None, conversation inconnue"| s_empty
        s_get -->|"Some"| s_content
        s_content -->|"Text"| s_text
        s_content -->|"Array"| s_array
        s_content -->|"None"| s_none
        s_text --> s_rel
        s_array --> s_rel
        s_rel -->|"oui"| s_dropped
        s_rel -->|"non"| s_score
    end

    subgraph medium_box["medium_term.rs — MediumTermMemory, project-orchestrator"]
        direction TB
        m_cfg["✅ McpConfig::default()<br/>PROJECT_ORCHESTRATOR_URL sinon http://localhost:8080,<br/>PROJECT_ORCHESTRATOR_KEY en option<br/><i>vérifié : test_config_default, seule la branche de repli localhost</i>"]
