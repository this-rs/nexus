        m_map["✅ filter_map(from_value ok)<br/>un élément incomplet est jeté, ses voisins passent,<br/>et la perte n'est signalée nulle part<br/><i>vérifié : un plan sans title disparaît</i>"]
        m_score["✅ calculate_score()<br/>semantic = mots trouvés sur mots demandés, 0,0 si requête vide<br/>recency figée à 0,5, jamais calculée<br/>scope : decision 0,9, task 0,8, plan 0,7, note 0,6<br/>aucun seuil : une entité qui ne correspond à rien est renvoyée<br/><i>vérifié : scores exacts relus étage par étage</i>"]
        m_default["✅ bras par défaut du match, scope 0,5<br/>inatteignable depuis les quatre appelants, qui passent<br/>toujours un des quatre libellés<br/><i>vérifié : appel direct depuis le module de test interne</i>"]
        m_date{"✅ DateTime::parse_from_rfc3339(plan.created_at)<br/><i>vérifié : date valide, décalage horaire, date illisible</i>"}
