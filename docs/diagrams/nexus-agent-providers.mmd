        IC["✅ InteractiveClient + SubprocessTransport + message_parser (ce que la façade enveloppe)<br/><i>vérifié : tests/interactive_client_fake_cli.rs, transport_subprocess_runtime.rs</i>"]
        CCP --> IC
    end

    subgraph model["model/ — client OpenAI-compatible"]
        direction TB
        MOD["🟠 client chat/completions (HTTP + SSE) vers un endpoint OpenAI-compatible : catalog() via /models, deltas via stream<br/><i>vérifié absent : pas de model/ ; reqwest n'est qu'optionnel (feature auto-download)</i>"]
        GW["🔴 claude-code-api/src/models/openai.rs existe mais dans le sens INVERSE :<br/>formes servies par la passerelle (ChatCompletionRequest en entrée), pas un client<br/><i>vérifié : api/chat.rs chat_completions est un handler axum</i>"]
        DEP["🔴 reqwest est une dépendance optionnelle du SDK (auto-download) : model/ devra la rendre non optionnelle ou la mettre derrière une feature dédiée<br/><i>vérifié : Cargo.toml reqwest optional = true</i>"]
        MOD -.-> GW
        MOD -.-> DEP
    end

    subgraph native["providers/native"]
        NAT["🟠 harness natif : AgentProvider composé sur ModelEndpoint, boucle d'outils MCP seulement, budget, transcript, compaction<br/><i>tranché A2 ; vérifié absent : pas de providers/native</i>"]
    end

