        o_exec --> o_norelease["🔴 pool.release() n'est atteint qu'en succès :<br/>un échec perd la connexion au lieu<br/>de la rendre au pool"]
        o_acq{"🟠 ConnectionPool::acquire()<br/>une connexion oisive est-elle valide ?"}
        o_acq -->|"oui"| o_reuse["🟠 réutilisée"]
        o_acq -->|"non"| o_fresh["🔴 nouveau SubprocessTransport ;<br/>le permis du sémaphore est lâché à la sortie<br/>de la fonction, donc rien n'est borné"]
        o_exec --> o_acq
        o_collect["🟠 collect_messages()<br/>met à jour le budget sur Result<br/>puis s'arrête au Result"]
        o_exec --> o_collect

        o_sess{"🟠 start_interactive_session()<br/>mode == Interactive ?"}
        o_sess -->|"non"| o_sess_ko["🟠 InvalidState Client not in interactive mode"]
        o_sess -->|"oui"| o_proc
        o_proc["🔴 start_message_processor()<br/>re-appelle receive_messages() à chaque tour<br/>de boucle — un abonnement neuf par message —<br/>et tient le write lock à travers le await"]
        o_si{"🟠 send_interactive() / receive_interactive()<br/>session active ?"}
        o_si -->|"non"| o_si_ko["🟠 InvalidState<br/>No active interactive session"]
        o_si -->|"oui"| o_si_ok["🟠 InputMessage::user(..., default)"]
        o_proc --> o_si
        o_int{"🟠 interrupt()<br/>transport courant présent ?"}
        o_int -->|"non"| o_int_ko["🟠 InvalidState No active session"]
        o_int -->|"oui"| o_int_ok["🟠 ControlRequest::Interrupt(uuid v4)<br/>aucun ack n'est attendu,<br/>contrairement à client.rs"]
        o_end["🟠 end_interactive_session()<br/>rend le transport au pool et oublie le récepteur"]

        o_batch{"🟠 process_batch(prompts)<br/>mode == Batch ?"}
        o_batch -->|"non"| o_batch_ko["🟠 InvalidState Client not in batch mode"]
        o_batch -->|"oui"| o_batch_ok["🔴 un spawn par prompt ;<br/>acquire_owned().await.unwrap() panique<br/>si le sémaphore est fermé"]
        o_batch_ok --> o_q
    end
